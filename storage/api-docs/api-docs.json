{
    "openapi": "3.0.0",
    "info": {
        "title": "Panel Admin API",
        "description": "API del panel de call center: clientes (registros), estado por tiempo y botones.",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "/api",
            "description": "Servidor local"
        }
    ],
    "paths": {
        "/buttons": {
            "get": {
                "tags": [
                    "Botones"
                ],
                "summary": "Lista los botones creados (id, nombre y mensaje)",
                "operationId": "8b9471c5be02ab08208ec1aa8cd2800c",
                "responses": {
                    "200": {
                        "description": "Listado de botones",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "properties": {
                                                    "id": {
                                                        "type": "integer",
                                                        "example": 1
                                                    },
                                                    "nombre": {
                                                        "type": "string",
                                                        "example": "Licencia"
                                                    },
                                                    "mensaje": {
                                                        "type": "string",
                                                        "example": "Tu licencia está activa."
                                                    },
                                                    "url": {
                                                        "description": "URL interna del botón.",
                                                        "type": "string",
                                                        "example": "https://interno/accion",
                                                        "nullable": true
                                                    }
                                                },
                                                "type": "object"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/clients": {
            "get": {
                "tags": [
                    "Clientes"
                ],
                "summary": "Lista de clientes con su estado (verde/amarillo/gris/rojo)",
                "operationId": "6536f8d22d25758c3e14dbbe8e228af0",
                "responses": {
                    "200": {
                        "description": "Listado de clientes"
                    }
                }
            },
            "post": {
                "tags": [
                    "Clientes"
                ],
                "summary": "Registra un cliente nuevo (el registro se genera internamente)",
                "operationId": "74a35b85418e09c2489915865dd22445",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "empresa",
                                    "fecha"
                                ],
                                "properties": {
                                    "empresa": {
                                        "type": "string",
                                        "example": "Acme S.A."
                                    },
                                    "fecha": {
                                        "type": "string",
                                        "format": "date-time",
                                        "example": "2026-11-02 09:30"
                                    },
                                    "name": {
                                        "type": "string",
                                        "example": "Juan Pérez"
                                    },
                                    "telegram_chat_id": {
                                        "type": "string",
                                        "example": "123456789"
                                    },
                                    "messenger_id": {
                                        "description": "Id del usuario de Telegram; destino exacto del botón.",
                                        "type": "string",
                                        "example": "123456789"
                                    },
                                    "data": {
                                        "description": "Cualquier otro dato libre",
                                        "type": "object",
                                        "example": {
                                            "plan": "premium",
                                            "origen": "web"
                                        }
                                    },
                                    "registro": {
                                        "description": "Generado por el servidor; se devuelve en la respuesta.",
                                        "type": "string",
                                        "readOnly": true,
                                        "example": "REG-0001"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Cliente creado"
                    },
                    "200": {
                        "description": "Cliente actualizado"
                    },
                    "422": {
                        "description": "Datos inválidos"
                    }
                }
            }
        },
        "/companies/{company}/send": {
            "post": {
                "tags": [
                    "Mensajería"
                ],
                "summary": "Envía el texto de un botón al Telegram del cliente (notificación)",
                "description": "Envía, como notificación, el texto del botón al chat de Telegram del cliente, usando el bot del propio cliente. No controla ninguna pantalla.",
                "operationId": "b36a5c01c9180598eb80c65d400593b6",
                "parameters": [
                    {
                        "name": "company",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "button_id"
                                ],
                                "properties": {
                                    "button_id": {
                                        "type": "integer",
                                        "example": 1
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Mensaje enviado"
                    },
                    "403": {
                        "description": "El cliente no está asignado a este operador"
                    },
                    "422": {
                        "description": "Cliente sin Telegram configurado o datos inválidos"
                    },
                    "502": {
                        "description": "Telegram rechazó o no respondió el envío"
                    }
                }
            }
        },
        "/telegram/latest-message": {
            "get": {
                "tags": [
                    "Mensajería"
                ],
                "summary": "Consulta el último mensaje del chat global configurado",
                "operationId": "d673dc158a42dd4cc8527bd6c3268003",
                "responses": {
                    "200": {
                        "description": "Último mensaje recibido, o null si todavía no hay mensajes",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "properties": {
                                                "mensaje": {
                                                    "type": "string",
                                                    "nullable": true
                                                }
                                            },
                                            "type": "object",
                                            "nullable": true
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/telegram/webhook": {
            "post": {
                "tags": [
                    "Mensajería"
                ],
                "summary": "Recibe las respuestas del cliente desde Telegram",
                "description": "Telegram envía aquí cada mensaje del cliente. Se asocia por chat_id al cliente y queda en su detalle como mensaje entrante.",
                "operationId": "36223551292e91c24b3d9b42f9353ffc",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "message": {
                                        "properties": {
                                            "text": {
                                                "type": "string",
                                                "example": "solicitud"
                                            },
                                            "chat": {
                                                "properties": {
                                                    "id": {
                                                        "type": "integer",
                                                        "example": -1001234567890
                                                    }
                                                },
                                                "type": "object"
                                            }
                                        },
                                        "type": "object"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Recibido"
                    }
                }
            }
        }
    },
    "tags": [
        {
            "name": "Botones",
            "description": "Botones"
        },
        {
            "name": "Clientes",
            "description": "Clientes"
        },
        {
            "name": "Mensajería",
            "description": "Mensajería"
        }
    ]
}