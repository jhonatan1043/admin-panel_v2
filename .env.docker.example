# Copia este archivo a .env.docker y ajusta los valores:
#   docker compose --env-file .env.docker up -d --build

APP_NAME="Panel Admin"
APP_ENV=production
APP_DEBUG=false
# Genera uno con: php artisan key:generate --show
APP_KEY=
APP_URL=http://localhost:8080
APP_PORT=8080
TZ=America/Bogota

APP_LOCALE=es
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_DATABASE=panel_admin
DB_USERNAME=panel
DB_PASSWORD=cambia_esto
DB_ROOT_PASSWORD=cambia_esto_tambien

SESSION_DRIVER=database
SESSION_LIFETIME=120
# true si sirves la app por HTTPS
SESSION_SECURE_COOKIE=false

QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

MAIL_MAILER=log

L5_SWAGGER_GENERATE_ALWAYS=false

# --- Opciones del contenedor ---
RUN_MIGRATIONS=true
RUN_QUEUE=true
QUEUE_WORKERS=1
RUN_SCHEDULER=true
